flowchart TB

    %% ================================================================
    %%  CLASS DEFINITIONS  -  matching global style
    %% ================================================================

    classDef ibSwitch    fill:#1a1a2e,stroke:#7b2fff,stroke-width:3px,color:#e0d7ff,font-weight:bold
    classDef ethSwitch   fill:#0f3460,stroke:#00b4d8,stroke-width:2px,color:#caf0f8,font-weight:bold
    classDef mgmtSwitch  fill:#2b2b2b,stroke:#aaaaaa,stroke-width:2px,color:#dddddd,font-weight:bold
    classDef gpuNode     fill:#16213e,stroke:#f5a623,stroke-width:2px,color:#fff3cd,font-weight:bold
    classDef ethPort     fill:#0a2342,stroke:#2980b9,stroke-width:1px,color:#aed6f1
    classDef bmcPort     fill:#222222,stroke:#7f8c8d,stroke-width:1px,color:#bdc3c7
    classDef hotStore    fill:#1a2e1a,stroke:#27ae60,stroke-width:2px,color:#a9dfbf,font-weight:bold
    classDef coldStore   fill:#1a1a2e,stroke:#00b4d8,stroke-width:2px,color:#caf0f8,font-weight:bold
    classDef blockStore  fill:#2e1a0a,stroke:#e67e22,stroke-width:2px,color:#fdebd0,font-weight:bold

    classDef localNvme   fill:#1c1c0a,stroke:#f5a623,stroke-width:1px,color:#fff3cd

    %% ================================================================
    %%  SWITCH PLANE  -  Shared with compute (no changes)
    %% ================================================================

    subgraph SW_PLANE ["NETWORK SWITCH PLANE"]
        direction LR

        IB_SW["NVIDIA Quantum-2 QM9700
        InfiniBand NDR 400G  |  64 Ports
        GPU Training Fabric Only — No Storage Traffic"]

        subgraph ETH_PLANE ["Ethernet Plane  |  MLAG L3 BGP Pair  |  Storage + K8s Traffic"]
            direction LR

            ETH_SW1["SONIC Leaf Switch 1
            100GbE  |  32 Ports
            Rack A ToR  |  RoCEv2"]

            ETH_SW2["SONIC Leaf Switch 2
            100GbE  |  32 Ports
            Rack B ToR  |  RoCEv2"]

            ETH_SW1 ===|MLAG Peer Link| ETH_SW2
        end

        MGMT_SW["Management Switch
        1GbE  |  48 Ports
        iDRAC / BMC / IPMI"]
    end

    %% ================================================================
    %%  COMPUTE RACK A  -  Nodes 1 to 4
    %% ================================================================

    subgraph RACK_A ["COMPUTE RACK A  |  GPU Nodes 1-4  |  40.8 kW"]
        direction LR

        A_ETH["8x 100GbE Eth Ports
        4 Servers x 2 Ports"]
        A_BMC["8x 1GbE BMC Ports
        4 Servers x 2 Ports"]
        A_LOCAL["Local NVMe Scratch
        4 Servers x 15.36 TB
        61.44 TB total — Tier 1"]
    end

    %% ================================================================
    %%  COMPUTE RACK B  -  Nodes 5 to 8
    %% ================================================================

    subgraph RACK_B ["COMPUTE RACK B  |  GPU Nodes 5-8  |  40.8 kW"]
        direction LR

        B_ETH["8x 100GbE Eth Ports
        4 Servers x 2 Ports"]
        B_BMC["8x 1GbE BMC Ports
        4 Servers x 2 Ports"]
        B_LOCAL["Local NVMe Scratch
        4 Servers x 15.36 TB
        61.44 TB total — Tier 1"]
    end

    %% ================================================================
    %%  STORAGE RACK C  -  All network-attached storage nodes
    %% ================================================================

    subgraph RACK_C ["STORAGE RACK C  |  Dedicated Storage & Control Plane"]
        direction TB



        %% ----------------------------------------------------------------
        %%  WEKA HOT STORAGE  -  Tier 2
        %% ----------------------------------------------------------------

        subgraph WEKA_NODES ["WEKA Hot Storage  |  3x NVMe Storage Servers  |  Tier 2"]
            direction LR
            WEKA_FS["WEKA Data Platform
            Parallel Filesystem
            PCIe 5.0 NVMe SSDs
            200 TB  |  10M+ IOPS
            Latency: under 100 us"]
            WEKA_ETH["6x Dual 100GbE
            RoCEv2 RDMA Ports"]
        end

        %% ----------------------------------------------------------------
        %%  MINIO COLD STORAGE  -  Tier 3
        %% ----------------------------------------------------------------

        subgraph MINIO_NODES ["MinIO Cold Storage  |  4x HDD Storage Servers  |  Tier 3"]
            direction LR
            MINIO_S3["MinIO Enterprise
            S3-Compatible Object Store
            SATA HDD  7200 RPM
            600 TB  |  Erasure Coded
            Bandwidth: 10-40 GB/s"]
            MINIO_ETH["8x 100GbE Eth Ports"]
        end

        %% ----------------------------------------------------------------
        %%  CEPH BLOCK STORAGE  -  Tier 4
        %% ----------------------------------------------------------------

        subgraph CEPH_NODES ["Ceph Block Storage  |  3x OSD Nodes  |  Tier 4"]
            direction LR
            CEPH_RBD["Ceph RBD  via  Rook Operator
            RADOS Block Device
            Mixed NVMe + SATA SSD
            200 TB  |  100K+ IOPS
            3x Replication  |  Mon Quorum"]
            CEPH_ETH["6x Dual 100GbE Eth Ports"]
        end
    end

    %% ================================================================
    %%  ETHERNET CABLING  -  Compute Racks to SONIC Switches
    %% ================================================================

    A_ETH ===|100GbE Fiber  Storage + K8s| ETH_SW1
    A_ETH ===|100GbE Fiber  Storage + K8s| ETH_SW2
    B_ETH ===|100GbE Fiber  Storage + K8s| ETH_SW1
    B_ETH ===|100GbE Fiber  Storage + K8s| ETH_SW2

    %% ================================================================
    %%  ETHERNET CABLING  -  Storage Rack C to SONIC Switches
    %%  Storage Rack connects to BOTH switches for HA path redundancy
    %% ================================================================


    WEKA_ETH ===|Dual 100GbE  RoCEv2 RDMA| ETH_SW1
    WEKA_ETH ===|Dual 100GbE  RoCEv2 RDMA| ETH_SW2
    MINIO_ETH ===|100GbE  S3 Object Traffic| ETH_SW1
    MINIO_ETH ===|100GbE  Redundant Path| ETH_SW2
    CEPH_ETH ===|Dual 100GbE  RBD Block Traffic| ETH_SW1
    CEPH_ETH ===|Dual 100GbE  Redundant Path| ETH_SW2

    %% ================================================================
    %%  BMC MANAGEMENT CABLING  -  Out-of-band
    %% ================================================================

    A_BMC -..->|1GbE OOB| MGMT_SW
    B_BMC -..->|1GbE OOB| MGMT_SW


    %% ================================================================
    %%  IB SWITCH  -  No storage traffic
    %% ================================================================

    IB_SW -.-|GPU Training Only — No Storage| IB_SW

    %% ================================================================
    %%  APPLY CLASSES
    %% ================================================================

    class IB_SW ibSwitch
    class ETH_SW1,ETH_SW2 ethSwitch
    class MGMT_SW mgmtSwitch
    class A_ETH,B_ETH,MINIO_ETH ethPort
    class A_BMC,B_BMC bmcPort
    class A_LOCAL,B_LOCAL localNvme
    class WEKA_FS,WEKA_ETH hotStore
    class MINIO_S3,MINIO_ETH coldStore
    class CEPH_RBD,CEPH_ETH blockStore
