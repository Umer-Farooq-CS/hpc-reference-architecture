    %% ================================================================
    %%  VERTICAL LAYER CONNECTIONS
    %%  Each arrow = "this layer provides the foundation for the one above"
    %% ================================================================

    L0 --> L1
    L1 --> L2
    L2 --> L3
    L3 --> L4
    L4 --> L5
    L5 --> L6

    %% ================================================================
    %%  HORIZONTAL CROSS-LAYER INTERACTIONS
    %%  Rafay is the management plane — it touches many layers
    %% ================================================================

    RAFAY -- "GitOps Blueprint push\nvia ArgoCD" --> ARGOCD
    ARGOCD -- "Deploys / reconciles\nall K8s workloads" --> API

    RAFAY -- "Manages vCluster\nlifecycle" --> T_VCLUSTER
    RAFAY -- "Provisions tenant\nnamespaces & RBAC" --> T_SHARED

    SSP -- "Tenant requests\nvia Rafay API" --> RAFAY

    KAI -- "Gang-schedules\nGPU Pods" --> GPUOP
    KAI -- "Enforces GPU\nquota per tenant" --> T_SHARED
    KAI -- "Enforces GPU\nquota per vCluster" --> T_VCLUSTER

    EDA -- "Zero-touch switch\nconfiguration" --> SONIC
    SONIC -- "VxLAN tunnels\nfor tenant isolation" --> VXLAN

    METAL3 -- "PXE boots → OS install\non GPU Worker nodes" --> H_COMPUTE

    PROM -- "Scrapes GPU\nmetrics" --> GPUOP
    PROM -- "Scrapes cluster\nmetrics" --> API

    CSI_DRIVERS -- "Mounts volumes\nfrom physical storage" --> H_STORE

