    %% ================================================================
    %%  CLASS DEFINITIONS  -  matching global style
    %% ================================================================

    classDef ibSwitch   fill:#1a1a2e,stroke:#7b2fff,stroke-width:3px,color:#e0d7ff,font-weight:bold
    classDef ethSwitch  fill:#0f3460,stroke:#00b4d8,stroke-width:2px,color:#caf0f8,font-weight:bold
    classDef mgmtSwitch fill:#2b2b2b,stroke:#aaaaaa,stroke-width:2px,color:#dddddd,font-weight:bold
    classDef gpuNode    fill:#16213e,stroke:#f5a623,stroke-width:2px,color:#fff3cd,font-weight:bold
    classDef ibPort     fill:#2d1b69,stroke:#9b59b6,stroke-width:1px,color:#d7b4f3
    classDef ethPort    fill:#0a2342,stroke:#2980b9,stroke-width:1px,color:#aed6f1

    %% ================================================================
    %%  SINGLE IB SWITCH  -  Top
    %% ================================================================

    IB_SW["NVIDIA Quantum-2 QM9700
    InfiniBand NDR 400G  |  64 Ports
    Single-Switch  |  0-Hop  |  SHARP Offload"]

    %% ================================================================
    %%  RACK A IB PORTS  -  32 cables from 4 servers
    %% ================================================================

    subgraph RACK_A ["COMPUTE RACK A  |  Servers 1 to 4"]
        direction LR
        A_IB["32x NDR IB Cables
        4 Servers x 8 Ports each"]
        A_ETH["8x 100GbE Cables
        4 Servers x 2 Ports each"]
    end

    %% ================================================================
    %%  RACK B IB PORTS  -  32 cables from 4 servers
    %% ================================================================

    subgraph RACK_B ["COMPUTE RACK B  |  Servers 5 to 8"]
        direction LR
        B_IB["32x NDR IB Cables
        4 Servers x 8 Ports each"]
        B_ETH["8x 100GbE Cables
        4 Servers x 2 Ports each"]
    end

    %% ================================================================
    %%  SONIC ETHERNET PAIR  -  Both switches in Rack C (shared switch plane)
    %%  Cross-rack 100GbE fiber runs to Racks A and B compute nodes
    %% ================================================================

    subgraph ETH_PLANE ["Ethernet Plane  |  MLAG L3 BGP Pair  |  Rack C — Shared Switch Plane"]
        direction LR
        ETH_SW1["SONIC Leaf Switch 1
        100GbE  |  64 Ports  |  Rack C"]
        ETH_SW2["SONIC Leaf Switch 2
        100GbE  |  64 Ports  |  Rack C"]
        ETH_SW1 ===|4-Port MLAG Peer-Link LAG| ETH_SW2
    end

    %% ================================================================
    %%  CABLING CONNECTIONS
    %% ================================================================

    A_IB ==>|32x NDR DAC/AOC| IB_SW
    B_IB ==>|32x NDR DAC/AOC| IB_SW
    A_ETH ===|100GbE Fiber cross-rack| ETH_SW1
    A_ETH ===|100GbE Fiber cross-rack| ETH_SW2
    B_ETH ===|100GbE Fiber cross-rack| ETH_SW1
    B_ETH ===|100GbE Fiber cross-rack| ETH_SW2

    %% ================================================================
    %%  APPLY CLASSES
    %% ================================================================

    class IB_SW ibSwitch
    class ETH_SW1,ETH_SW2 ethSwitch
    class A_IB,B_IB ibPort
    class A_ETH,B_ETH ethPort
